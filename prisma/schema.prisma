generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local: SQLite. Producción / equipo: postgresql + docker-compose.yml
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ARRENDADOR
  ARRENDATARIO
  MUNICIPIO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@map("users")
}
