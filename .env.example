# Supabase Postgres
# Dashboard -> Connect -> Supavisor. Reemplaza [PASSWORD], [PROJECT-REF] y [REGION].

# La app usa el pooler en modo transacción (puerto 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma usa esta para migraciones y db push (puerto 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Alternativa local con Docker (docker compose up -d):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/manta360?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/manta360?schema=public"

AUTH_SECRET="change-me-to-a-long-random-string"
