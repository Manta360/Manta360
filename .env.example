# PostgreSQL de aplicacion. La aplicacion usa exclusivamente PG_APP_*.
# Usa el Session Pooler de Supabase (puerto 5432); nunca DATABASE_URL.
PG_APP_HOST="aws-0-[REGION].pooler.supabase.com"
PG_APP_PORT="5432"
PG_APP_DATABASE="postgres"
PG_APP_USER="postgres.ycerwszvzkmyisflxkpe"
PG_APP_PASSWORD="replace-with-application-password"
PG_APP_PROJECT_REF="ycerwszvzkmyisflxkpe"

# PostgreSQL temporal para integraciones. No reutilices PG_APP_* en fixtures.
PG_TEST_HOST="aws-0-[REGION].pooler.supabase.com"
PG_TEST_PORT="5432"
PG_TEST_DATABASE="postgres"
PG_TEST_USER="postgres.ycerwszvzkmyisflxkpe"
PG_TEST_PASSWORD="replace-with-test-password"

AUTH_SECRET="change-me-to-a-long-random-string"

# Supabase Storage de aplicacion: valores solo de servidor.
SUPABASE_URL="https://<PROJECT-REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"

# Storage temporal para bootstrap e integracion de manta360prueba.
SUPABASE_TEST_URL="https://ycerwszvzkmyisflxkpe.supabase.co"
SUPABASE_TEST_SERVICE_ROLE_KEY="replace-with-test-service-role-key"

# Requerida solo por npm run db:seed-municipio.
MUNICIPIO_PASSWORD="replace-with-a-strong-password"
