# =============================================================================
# Manta360 — variables de entorno (.env.example)
# Copia este archivo a .env y completa los valores reales.
# Nunca subas .env al repositorio.
# =============================================================================

# --- PostgreSQL de APLICACIÓN (obligatorio en local y producción) ---
# Usa el Session Pooler de Supabase (puerto 5432). La app NO usa DATABASE_URL.
PG_APP_HOST="aws-0-[REGION].pooler.supabase.com"
PG_APP_PORT="5432"
PG_APP_DATABASE="postgres"
PG_APP_USER="postgres.ycerwszvzkmyisflxkpe"
PG_APP_PASSWORD="replace-with-application-password"
PG_APP_PROJECT_REF="ycerwszvzkmyisflxkpe"

# --- PostgreSQL de PRUEBAS / E2E (KAN-60 e integraciones) ---
# No reutilices PG_APP_* en fixtures automatizados.
PG_TEST_HOST="aws-0-[REGION].pooler.supabase.com"
PG_TEST_PORT="5432"
PG_TEST_DATABASE="postgres"
PG_TEST_USER="postgres.ycerwszvzkmyisflxkpe"
PG_TEST_PASSWORD="replace-with-test-password"

# --- Sesión JWT ---
# Genera un valor largo y aleatorio (mín. 32 caracteres) distinto en producción.
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Supabase Storage de APLICACIÓN (solo servidor; nunca NEXT_PUBLIC_*) ---
SUPABASE_URL="https://<PROJECT-REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"

# --- Storage temporal (bootstrap / integración del proyecto de prueba) ---
SUPABASE_TEST_URL="https://ycerwszvzkmyisflxkpe.supabase.co"
SUPABASE_TEST_SERVICE_ROLE_KEY="replace-with-test-service-role-key"

# --- Seed de usuario MUNICIPIO (npm run db:seed-municipio) ---
# Alternativa: usar el seed incluido en database/BDD.sql (Demo1234!).
MUNICIPIO_PASSWORD="replace-with-a-strong-password"

# Opcionales para el seed de municipio:
# MUNICIPIO_EMAIL="admin@tu-dominio.ec"
# MUNICIPIO_NAME="Administrador Municipal"
# MUNICIPIO_PHONE="0990000000"
# MUNICIPIO_CEDULA="0000000000"
